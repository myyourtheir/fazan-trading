{
  "name": "fazan-trading-backend",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node scripts/check-layer-boundaries.mjs && tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@ttech-pub/grpc-node-client": "1.61.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "nice-grpc": "^2.2.0",
    "pg": "^8.16.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
