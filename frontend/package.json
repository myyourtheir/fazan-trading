{
  "name": "fazan-trading-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-path .prettierignore",
    "format:check": "prettier . --check --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "vite preview",
    "lint:architecture": "steiger ./src --fail-on-warnings",
    "test": "npm run lint:architecture && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^1.75.0",
    "react": "^19.1.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "3.6.2",
    "shadcn": "^4.23.0",
    "steiger": "^0.10.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0"
  }
}
